# Portex backend configuration. Everything has a localhost default: with anvil running on
# :8545 and contracts deployed (../contracts/scripts/deploy-local.sh), `bun run dev` needs
# NO configuration at all.

# Chain
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# Blocks to wait before indexing (re-org safety). 0 is fine on anvil.
CONFIRMATIONS=0
# Indexer poll interval (ms) and getLogs page size (blocks).
POLL_MS=1000
LOG_PAGE=1000

# HTTP server
PORT=8790
CORS_ORIGINS=http://localhost:3100
# Public base URL of this API, used to build report URIs posted on-chain.
PUBLIC_API_URL=http://localhost:8790

# SQLite database location.
DATABASE_PATH=./data/portex.db

# Comma-separated admin addresses (reserved; not required by any v1 endpoint).
ADMIN_ADDRESSES=

# Key used to post analyst reports on-chain via AttestationBoard.postReport.
# On chain 31337 it defaults to anvil account #1 (the attester account) when unset.
ATTESTER_PRIVATE_KEY=

# Optional LLM scorer. Without a key the analyst panel is the deterministic heuristic only.
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-sonnet-5

# Optional: re-run the analyst on a timer (ms) for raises still in Incubation. 0/empty = off.
ANALYST_INTERVAL_MS=
