{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "*.ts",
    ".next-build/types/**/*.ts",
    ".next-debug/types/**/*.ts",
    ".next-e2e-100/types/**/*.ts",
    ".next-e2e-200/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-local-3100/types/**/*.ts",
    ".next-local-3200/types/**/*.ts",
    ".next-local-3300/types/**/*.ts",
    ".next-testnet-e2e-100/types/**/*.ts",
    ".next-testnet-e2e-200/types/**/*.ts",
    ".next-testnet-e2e/types/**/*.ts",
    ".next-testnet/types/**/*.ts",
    ".next/types/**/*.ts",
    "e2e/*.ts",
    "next-env.d.ts",
    "scripts/*.mts",
    "scripts/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    ".next-shots-3200/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e/.tmp",
    ".work",
    ".next",
    ".next-build",
    ".next-e2e"
  ]
}
