# =====================================================================
# Portex process-environment reference. No script loads a .env file:
# inject values through your shell, secret manager or the server's env file.
# X Layer testnet (1952) is the default; anvil (31337) is for local runs and tests.
# =====================================================================

# ---------- network ----------
# App network: 1952 (testnet, default), 196 (mainnet), 31337 (local anvil).
PORTEX_CHAIN_ID=1952
NEXT_PUBLIC_CHAIN_ID=1952
# Optional Alchemy key; without it the API and scripts use X Layer's public RPC.
ALCHEMY_API_KEY=
# Optional explicit RPC for the API; never put a private RPC key in a NEXT_PUBLIC_ variable.
RPC_URL=

# ---------- contract deployment (tools/deploy-testnet.sh) ----------
# Deployer = curator of the registry. Attester and council default to the deployer.
DEPLOYER_PRIVATE_KEY=
PORTEX_ATTESTER=
PORTEX_COUNCIL=
# Governed timings applied after deployment: testnet (short, default on 1952) or production.
PORTEX_TIMINGS=testnet

# ---------- API server (apps/api) ----------
PORT=8790
DATABASE_PATH=apps/api/data/portex-1952.db
PUBLIC_API_URL=http://localhost:8790
CORS_ORIGINS=http://localhost:3100
# X Layer's public RPC answers eth_getLogs for at most 100 blocks.
LOG_PAGE=100
CONFIRMATIONS=3
# Lowercase addresses allowed to trigger analyses without the rate limit.
ADMIN_ADDRESSES=
# Project images: pinned to IPFS through Pinata when set, otherwise stored on the API host.
PINATA_JWT=
PINATA_GATEWAY=
# AI analyst: any Anthropic-compatible endpoint. Without a key it runs in heuristic mode.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANALYST_MODEL=
# Key the analyst uses to post vetoes on-chain (the attester). Optional.
ATTESTER_PRIVATE_KEY=

# ---------- web app (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:8790
# Optional WalletConnect Cloud project ID; enables the WalletConnect connector.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------- testnet activity runner (tools/mock) ----------
# Funds the persona wallets' gas on testnet (a development account only).
MOCK_FUNDER_PRIVATE_KEY=
# Optional OpenAI-compatible model for the personas' judgement; without it they use templates.
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash
